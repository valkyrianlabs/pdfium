#!/usr/bin/env bash
# Run the package tests in disposable stock Ubuntu 24.04 containers (ci/run-ci --image).
#
#   tests/package/run [DEB_DIR] [clean-install|legacy-transition|rebuild-from-source|published|all]
#
# DEB_DIR defaults to release/ (where `vlr build-deb` puts the packages). The repository is
# mounted, so the tests use its consumer sources and the prepared upstream/ test documents.
set -euo pipefail
repo=$(cd "$(dirname "$0")/../.." && pwd)
deb_dir=${1:-release}
which=${2:-all}
image=$(sed -n 's/^FROM //p' "$repo/ci/Containerfile" | head -n1)
case "$which" in
  all) suites=(clean-install legacy-transition rebuild-from-source) ;;
  clean-install | legacy-transition | rebuild-from-source | published) suites=("$which") ;;
  *) echo "unknown suite $which" >&2; exit 2 ;;
esac
for suite in "${suites[@]}"; do
  "$repo/ci/run-ci" --image "$image" --root env REBUILD_JOBS="${REBUILD_JOBS:-4}" LEGACY_DEB_DIR="${LEGACY_DEB_DIR:-}" APT_URL="${APT_URL:-}" bash "tests/package/$suite.sh" "$deb_dir"
done
