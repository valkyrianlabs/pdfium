# find_package(Pdfium) support for libpdfium @VERSION@ (generated by Meson; no CMake involved in
# building PDFium). Provides the imported target Pdfium::pdfium, as the legacy package did.
get_filename_component(_pdfium_prefix "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
get_filename_component(_pdfium_real "${CMAKE_CURRENT_LIST_DIR}" REALPATH)
if(_pdfium_real MATCHES "^/usr/@LIBDIR@/cmake/pdfium$")
  set(_pdfium_prefix "/usr")
endif()

if(NOT TARGET Pdfium::pdfium)
  add_library(Pdfium::pdfium SHARED IMPORTED)
  set_target_properties(Pdfium::pdfium PROPERTIES
    IMPORTED_LOCATION "${_pdfium_prefix}/@LIBDIR@/@LIBRARY@"
    IMPORTED_SONAME "@SONAME@"
    INTERFACE_INCLUDE_DIRECTORIES "${_pdfium_prefix}/@INCLUDEDIR@/pdfium"
  )
endif()

set(Pdfium_VERSION "@VERSION@")
set(Pdfium_FOUND TRUE)
unset(_pdfium_prefix)
unset(_pdfium_real)
