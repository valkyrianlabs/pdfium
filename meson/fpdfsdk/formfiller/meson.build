# Mirrors fpdfsdk/formfiller/BUILD.gn for the supported configuration (upstream.toml [audit.args]).
# Source paths are relative to that directory, as in GN; only compiled sources are listed.
# `tools/pdfium-dist audit` reports every difference from upstream.

# formfiller
pdfium_components += [{
  'name': 'fpdfsdk_formfiller',
  'gn': '//fpdfsdk/formfiller:formfiller',
  'dir': 'fpdfsdk/formfiller',
  'sources': [
    'cffl_button.cpp',
    'cffl_checkbox.cpp',
    'cffl_combobox.cpp',
    'cffl_fieldaction.cpp',
    'cffl_formfield.cpp',
    'cffl_interactiveformfiller.cpp',
    'cffl_listbox.cpp',
    'cffl_perwindowdata.cpp',
    'cffl_pushbutton.cpp',
    'cffl_radiobutton.cpp',
    'cffl_textfield.cpp',
    'cffl_textobject.cpp',
  ],
}]
