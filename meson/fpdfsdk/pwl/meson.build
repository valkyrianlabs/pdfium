# Mirrors fpdfsdk/pwl/BUILD.gn for the supported configuration (upstream.toml [audit.args]).
# Source paths are relative to that directory, as in GN; only compiled sources are listed.
# `tools/pdfium-dist audit` reports every difference from upstream.

# pwl
pdfium_components += [{
  'name': 'fpdfsdk_pwl',
  'gn': '//fpdfsdk/pwl:pwl',
  'dir': 'fpdfsdk/pwl',
  'sources': [
    'cpwl_button.cpp',
    'cpwl_caret.cpp',
    'cpwl_cbbutton.cpp',
    'cpwl_cblistbox.cpp',
    'cpwl_combo_box.cpp',
    'cpwl_edit.cpp',
    'cpwl_edit_impl.cpp',
    'cpwl_list_box.cpp',
    'cpwl_list_ctrl.cpp',
    'cpwl_sbbutton.cpp',
    'cpwl_scroll_bar.cpp',
    'cpwl_special_button.cpp',
    'cpwl_wnd.cpp',
  ],
}]
