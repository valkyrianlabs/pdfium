# Mirrors core/fpdfdoc/BUILD.gn for the supported configuration (upstream.toml [audit.args]).
# Source paths are relative to that directory, as in GN; only compiled sources are listed.
# `tools/pdfium-dist audit` reports every difference from upstream.

# fpdfdoc
pdfium_components += [{
  'name': 'fpdfdoc',
  'gn': '//core/fpdfdoc:fpdfdoc',
  'dir': 'core/fpdfdoc',
  'sources': [
    'cpdf_aaction.cpp',
    'cpdf_action.cpp',
    'cpdf_annot.cpp',
    'cpdf_annotlist.cpp',
    'cpdf_apsettings.cpp',
    'cpdf_bafontmap.cpp',
    'cpdf_bookmark.cpp',
    'cpdf_bookmarktree.cpp',
    'cpdf_color_utils.cpp',
    'cpdf_defaultappearance.cpp',
    'cpdf_dest.cpp',
    'cpdf_filespec.cpp',
    'cpdf_formcontrol.cpp',
    'cpdf_formfield.cpp',
    'cpdf_generateap.cpp',
    'cpdf_icon.cpp',
    'cpdf_iconfit.cpp',
    'cpdf_interactiveform.cpp',
    'cpdf_link.cpp',
    'cpdf_linklist.cpp',
    'cpdf_metadata.cpp',
    'cpdf_nametree.cpp',
    'cpdf_numbertree.cpp',
    'cpdf_pagelabel.cpp',
    'cpdf_structelement.cpp',
    'cpdf_structtree.cpp',
    'cpdf_viewerpreferences.cpp',
    'cpvt_fontmap.cpp',
    'cpvt_section.cpp',
    'cpvt_variabletext.cpp',
    'cpvt_word.cpp',
    'cpvt_wordinfo.cpp',
  ],
}]
