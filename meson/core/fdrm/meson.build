# Mirrors core/fdrm/BUILD.gn for the supported configuration (upstream.toml [audit.args]).
# Source paths are relative to that directory, as in GN; only compiled sources are listed.
# `tools/pdfium-dist audit` reports every difference from upstream.

# fdrm
pdfium_components += [{
  'name': 'fdrm',
  'gn': '//core/fdrm:fdrm',
  'dir': 'core/fdrm',
  'sources': [
    'fx_crypt.cpp',
    'fx_crypt_aes.cpp',
    'fx_crypt_sha.cpp',
  ],
}]
