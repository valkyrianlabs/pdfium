# Mirrors core/fpdfapi/render/BUILD.gn for the supported configuration (upstream.toml [audit.args]).
# Source paths are relative to that directory, as in GN; only compiled sources are listed.
# `tools/pdfium-dist audit` reports every difference from upstream.

# render
pdfium_components += [{
  'name': 'fpdfapi_render',
  'gn': '//core/fpdfapi/render:render',
  'dir': 'core/fpdfapi/render',
  'sources': [
    'cpdf_devicebuffer.cpp',
    'cpdf_docrenderdata.cpp',
    'cpdf_imagerenderer.cpp',
    'cpdf_pagerendercontext.cpp',
    'cpdf_progressiverenderer.cpp',
    'cpdf_rendercontext.cpp',
    'cpdf_renderoptions.cpp',
    'cpdf_rendershading.cpp',
    'cpdf_renderstatus.cpp',
    'cpdf_rendertiling.cpp',
    'cpdf_textrenderer.cpp',
    'cpdf_type3cache.cpp',
    'cpdf_type3glyphmap.cpp',
  ],
}]
