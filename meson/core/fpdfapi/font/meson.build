# Mirrors core/fpdfapi/font/BUILD.gn for the supported configuration (upstream.toml [audit.args]).
# Source paths are relative to that directory, as in GN; only compiled sources are listed.
# `tools/pdfium-dist audit` reports every difference from upstream.

# font
pdfium_components += [{
  'name': 'fpdfapi_font',
  'gn': '//core/fpdfapi/font:font',
  'dir': 'core/fpdfapi/font',
  'sources': [
    'cpdf_cid2unicodemap.cpp',
    'cpdf_cidfont.cpp',
    'cpdf_cmap.cpp',
    'cpdf_cmapparser.cpp',
    'cpdf_facebasedsimplefont.cpp',
    'cpdf_font.cpp',
    'cpdf_fontencoding.cpp',
    'cpdf_fontglobals.cpp',
    'cpdf_simplefont.cpp',
    'cpdf_stockfontarray.cpp',
    'cpdf_tounicodemap.cpp',
    'cpdf_truetypefont.cpp',
    'cpdf_type1font.cpp',
    'cpdf_type3char.cpp',
    'cpdf_type3font.cpp',
  ],
}]
