# Mirrors core/fpdfapi/page/BUILD.gn for the supported configuration (upstream.toml [audit.args]).
# Source paths are relative to that directory, as in GN; only compiled sources are listed.
# `tools/pdfium-dist audit` reports every difference from upstream.

# page: no Skia.
pdfium_components += [{
  'name': 'fpdfapi_page',
  'gn': '//core/fpdfapi/page:page',
  'dir': 'core/fpdfapi/page',
  'sources': [
    'cpdf_allstates.cpp',
    'cpdf_annotcontext.cpp',
    'cpdf_basedcs.cpp',
    'cpdf_clippath.cpp',
    'cpdf_color.cpp',
    'cpdf_colorspace.cpp',
    'cpdf_colorstate.cpp',
    'cpdf_contentmarkitem.cpp',
    'cpdf_contentmarks.cpp',
    'cpdf_contentparser.cpp',
    'cpdf_devicecs.cpp',
    'cpdf_dib.cpp',
    'cpdf_docpagedata.cpp',
    'cpdf_expintfunc.cpp',
    'cpdf_form.cpp',
    'cpdf_formobject.cpp',
    'cpdf_function.cpp',
    'cpdf_generalstate.cpp',
    'cpdf_graphicstates.cpp',
    'cpdf_iccprofile.cpp',
    'cpdf_image.cpp',
    'cpdf_imageloader.cpp',
    'cpdf_imageobject.cpp',
    'cpdf_indexedcs.cpp',
    'cpdf_meshstream.cpp',
    'cpdf_occontext.cpp',
    'cpdf_page.cpp',
    'cpdf_pageimagecache.cpp',
    'cpdf_pagemodule.cpp',
    'cpdf_pageobject.cpp',
    'cpdf_pageobjectholder.cpp',
    'cpdf_path.cpp',
    'cpdf_pathobject.cpp',
    'cpdf_pattern.cpp',
    'cpdf_patterncs.cpp',
    'cpdf_psengine.cpp',
    'cpdf_psfunc.cpp',
    'cpdf_sampledfunc.cpp',
    'cpdf_shadingobject.cpp',
    'cpdf_shadingpattern.cpp',
    'cpdf_stitchfunc.cpp',
    'cpdf_streamcontentparser.cpp',
    'cpdf_streamparser.cpp',
    'cpdf_textobject.cpp',
    'cpdf_textstate.cpp',
    'cpdf_tilingpattern.cpp',
    'cpdf_transferfunc.cpp',
    'cpdf_transferfuncdib.cpp',
    'cpdf_transparency.cpp',
    'jpx_decode_conversion.cpp',
  ],
}]
