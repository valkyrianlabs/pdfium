# Mirrors core/fpdftext/BUILD.gn for the supported configuration (upstream.toml [audit.args]).
# Source paths are relative to that directory, as in GN; only compiled sources are listed.
# `tools/pdfium-dist audit` reports every difference from upstream.

# fpdftext
pdfium_components += [{
  'name': 'fpdftext',
  'gn': '//core/fpdftext:fpdftext',
  'dir': 'core/fpdftext',
  'sources': [
    'cpdf_linkextract.cpp',
    'cpdf_textpage.cpp',
    'cpdf_textpagefind.cpp',
    'unicodenormalizationdata.cpp',
  ],
}]
